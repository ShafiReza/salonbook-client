# URL of the salonbook-server (Express API). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Origin of THIS site. Better Auth requests go to <this origin>/api/auth/* and are proxied to the server.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
